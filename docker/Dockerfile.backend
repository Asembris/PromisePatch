# The backend image: one image, several entrypoints.
#
# `pp api`, `alembic upgrade head` and `pp reset-demo-state` are the same code with different
# arguments, so they are the same image with different commands. What separates them is not
# what they are able to run but what they are given: the API container receives the runtime
# connection and nothing else, while the migration and seed containers receive the
# administrative one. That separation lives in the compose file, where it can be read.
#
# Three stages: the first resolves and builds the locked dependency set, the second builds the
# browser bundle, and the third carries the resulting virtual environment, the bundle, and
# nothing that built either.

# ------------------------------------------------------------------------------- build stage

FROM python:3.12-slim-bookworm AS build

# The pinned uv release, taken from its own published image rather than curled at build time,
# so the toolchain is as reproducible as the lockfile it reads.
COPY --from=ghcr.io/astral-sh/uv:0.9.18 /uv /bin/uv

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/app/.venv

WORKDIR /src

# An optional additional root CA, for a machine whose antivirus or corporate proxy terminates
# TLS with a certificate this base image's trust store has never heard of. It is empty unless
# somebody puts a certificate in `docker/env/extra-ca.crt`, and an empty one installs nothing
# -- so this is a no-op in CI and on any ordinary network, and the difference between "the
# image builds here" and "the image does not" everywhere else. It is a build-stage concern
# only: the runtime stage starts from a clean base and copies the virtual environment.
RUN --mount=type=secret,id=extra_ca,target=/tmp/extra-ca.crt \
    if [ -s /tmp/extra-ca.crt ]; then \
        cp /tmp/extra-ca.crt /usr/local/share/ca-certificates/extra-ca.crt && \
        update-ca-certificates; \
    fi

# Dependencies before source. The manifests change rarely and the source changes constantly,
# so resolving them in their own layer means an ordinary code edit does not re-resolve the
# whole graph. `--no-install-workspace` is what keeps the two apart: it installs everything
# the workspace depends on and none of the workspace itself. Every member's manifest is copied
# because the lockfile describes the workspace as a whole; `--package` is what decides which
# of them is actually built into this image.
#
# `--frozen`: the lockfile is the input, never something the build is allowed to update. A
# build that could relock would be a build that could ship a dependency nobody reviewed.
COPY pyproject.toml uv.lock .python-version ./
COPY packages/promise-graph/pyproject.toml packages/promise-graph/pyproject.toml
COPY packages/order-contract/pyproject.toml packages/order-contract/pyproject.toml
COPY apps/backend/pyproject.toml apps/backend/pyproject.toml
COPY apps/order-simulator/pyproject.toml apps/order-simulator/pyproject.toml
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-editable --no-install-workspace --package promisepatch

# `--no-dev`: pytest, mypy, ruff and Hypothesis are how this code is verified, not how it
# runs, and a test runner in a serving image is attack surface with no counterpart benefit.
#
# `--no-editable`: the workspace members are built into real wheels and installed, so the
# runtime stage needs the virtual environment and not the source tree it was built from.
COPY packages/promise-graph packages/promise-graph
COPY packages/order-contract packages/order-contract
COPY apps/backend apps/backend
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-editable --package promisepatch

# ---------------------------------------------------------------------------- frontend stage

# The browser bundle, built here so that one image tag moves the whole surface and the UI is up
# exactly when the API is up. ADR-0012 records why the deployed host serves the bundle itself
# rather than a seventh container, a third image or an S3 origin.
#
# `--platform=$BUILDPLATFORM` builds this stage natively even when the image is being built for
# another architecture. The output is JavaScript, CSS and an HTML file, none of which is
# architecture-specific, so emulating a whole Node toolchain to produce identical bytes would
# cost minutes and buy nothing.
FROM --platform=$BUILDPLATFORM node:24-bookworm-slim AS frontend

# `NODE_ENV` is deliberately not set to `production`: `npm ci` would then skip the
# devDependencies, and vite, tailwind and typescript -- everything that performs the build
# -- are all in that group. Playwright's browsers are a test dependency and never a build
# one, so they are not downloaded into a stage whose only output is a directory of assets.
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

WORKDIR /ui

# The manifests first, for the same reason the Python dependencies go in their own layer: they
# change rarely and the source changes constantly. `npm ci` rather than `npm install` -- it
# installs the committed lockfile exactly and fails if the manifest and the lockfile disagree.
#
# The mounted certificate is the same optional additional root CA the build stage takes, for
# the same machine: mounted rather than copied, so it is neither a layer nor a difference
# between this build and the one CI runs.
COPY apps/frontend/package.json apps/frontend/package-lock.json ./
RUN --mount=type=secret,id=extra_ca,target=/tmp/extra-ca.crt \
    if [ -s /tmp/extra-ca.crt ]; then export NODE_EXTRA_CA_CERTS=/tmp/extra-ca.crt; fi; \
    npm ci

COPY apps/frontend/ ./

# `npm run build` is `tsc --build && vite build`: the same command the gate runs, so a type
# error fails the image build rather than shipping a bundle nobody typechecked. The output is
# `dist/`, and `dist/` is the only thing that leaves this stage.
RUN npm run build

# ----------------------------------------------------------------------------- runtime stage

FROM python:3.12-slim-bookworm AS runtime

# Non-root, and without a login shell. Nothing this process does needs to write to the
# filesystem: the state is in PostgreSQL and the logs go to stdout.
RUN useradd --system --create-home --shell /usr/sbin/nologin promisepatch

ENV PATH=/app/.venv/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

COPY --from=build --chown=promisepatch:promisepatch /app/.venv /app/.venv

# The migration scripts are data, not an installed package: Alembic reads them off disk. They
# are the only source in the image, and the only thing in it that a runtime container is given
# no credential to use.
COPY --chown=promisepatch:promisepatch apps/backend/alembic.ini apps/backend/alembic.ini
COPY --chown=promisepatch:promisepatch apps/backend/alembic apps/backend/alembic

# The browser bundle, and nothing that built it: no `node_modules`, no Node runtime, no source.
# `PP_STATIC_ROOT` is what the API reads to decide whether it serves a page at all -- unset, as
# it is everywhere outside this image, it serves the API and nothing else, which is what the
# local Vite dev server and every test expect.
COPY --from=frontend --chown=promisepatch:promisepatch /ui/dist /app/frontend
ENV PP_STATIC_ROOT=/app/frontend

USER promisepatch

# The API port, and only the API port. The migration and seed containers listen on nothing.
EXPOSE 8000

# uvicorn installs its own SIGTERM handler and runs the lifespan shutdown -- disposing the
# engine pool and releasing the listener's dedicated LISTEN connection -- so the container has
# to receive the signal directly. Exec form: no shell between the runtime and the signal.
CMD ["pp", "api", "--host", "0.0.0.0", "--port", "8000"]
