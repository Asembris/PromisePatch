# The External Order System simulator image.
#
# Its own image, not a second command on the backend's, because it is a different system. It
# carries no PromisePatch code, no SQLAlchemy model, no Alembic revision and no PostgreSQL
# driver -- there is nothing in it that could reach PromisePatch's database even if something
# tried. What it carries is the order system, the shared wire contract, and a directory to keep
# its own SQLite file in.
#
# Two stages, the same shape as the backend's: the first resolves and builds the locked
# dependency set, the second carries the resulting virtual environment and nothing that built
# it.

# ------------------------------------------------------------------------------- build stage

FROM python:3.12-slim-bookworm AS build

COPY --from=ghcr.io/astral-sh/uv:0.9.18 /uv /bin/uv

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/app/.venv

WORKDIR /src

# The same optional additional root CA the backend image takes, for the same reason: a machine
# whose TLS is terminated by an issuer this base image has never heard of. Empty by default,
# and an empty one installs nothing.
RUN --mount=type=secret,id=extra_ca,target=/tmp/extra-ca.crt \
    if [ -s /tmp/extra-ca.crt ]; then \
        cp /tmp/extra-ca.crt /usr/local/share/ca-certificates/extra-ca.crt && \
        update-ca-certificates; \
    fi

# Every workspace manifest, because `uv sync` resolves against the workspace as a whole -- but
# only two of the members' sources are copied below, so the image contains only what this
# application is.
COPY pyproject.toml uv.lock .python-version ./
COPY packages/promise-graph/pyproject.toml packages/promise-graph/pyproject.toml
COPY packages/order-contract/pyproject.toml packages/order-contract/pyproject.toml
COPY apps/backend/pyproject.toml apps/backend/pyproject.toml
COPY apps/order-simulator/pyproject.toml apps/order-simulator/pyproject.toml
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-editable --no-install-workspace --package order-simulator

COPY packages/order-contract packages/order-contract
COPY apps/order-simulator apps/order-simulator
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-editable --package order-simulator

# ----------------------------------------------------------------------------- runtime stage

FROM python:3.12-slim-bookworm AS runtime

# Non-root, and with a home it does not use. Unlike the backend this process *does* write to
# the filesystem -- its database is a file -- so the directory it writes to is created and
# owned explicitly rather than left to whatever the volume mount happens to allow.
RUN useradd --system --create-home --shell /usr/sbin/nologin ordersystem \
    && mkdir -p /data \
    && chown ordersystem:ordersystem /data

ENV PATH=/app/.venv/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    OS_DATABASE_PATH=/data/order-simulator.sqlite3

WORKDIR /app

COPY --from=build --chown=ordersystem:ordersystem /app/.venv /app/.venv

USER ordersystem

EXPOSE 8100

CMD ["order-simulator", "--host", "0.0.0.0", "--port", "8100"]
