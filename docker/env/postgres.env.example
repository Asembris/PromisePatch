# PostgreSQL container configuration for the disposable local stack.
#
# Generated by `uv run python scripts/bootstrap_local_env.py` into `postgres.env`, which is
# never committed. This is the superuser of a throwaway database that exists only inside a
# Docker volume on one machine; it is not a template for any deployed environment.

POSTGRES_USER=postgres
POSTGRES_DB=promisepatch
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
