# The privileged operator environment: migrations and `pp reset-demo-state`.
#
# Generated by `uv run python scripts/bootstrap_local_env.py` into `migrate.env`, which is
# never committed.
#
# This is the administrative connection. It creates tables, installs the audit triggers and
# owns the `promisepatch_app` role, and it is deliberately not the environment the API is
# given: a write boundary the application could step over by holding this credential would be
# a convention rather than a control.

PP_ENV=local
PP_LOG_LEVEL=info

# Admin/DDL connection. `postgres` is the compose service name; inside the network the
# database answers on its own port, not the one published to the host.
PP_MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:__POSTGRES_PASSWORD__@postgres:5432/promisepatch

# The password migration 0002 creates the least-privileged runtime role with. The API is
# handed the resulting connection string, never this value.
PP_DB_APP_PASSWORD=__APP_PASSWORD__

# The seeded demo logins, hashed with Argon2 by `pp reset-demo-state` before storage. Read
# them out of the generated `migrate.env` when you need to sign in.
PP_DEMO_WORKER_PASSWORD=__WORKER_PASSWORD__
PP_DEMO_OWNER_PASSWORD=__OWNER_PASSWORD__

# A reset empties every domain row PromisePatch owns, so it is refused unless someone who
# knows which database this is says otherwise. This one is a disposable Docker volume.
PP_ALLOW_FIXTURE_RESET=true

PP_BAKERY_TZ=Africa/Tunis
