# Host-side configuration for pointing repository tooling at the local stack.
#
# Generated by `uv run python scripts/bootstrap_local_env.py` into `host.env`, which is never
# committed. Use it with `scripts/with_local_env.py`, which loads this file and runs a command
# with it -- so the local stack never has to overwrite a `.env` that points somewhere else:
#
#     uv run python scripts/with_local_env.py -- uv run pytest apps/backend
#
# The difference from the container files is the address. Inside the compose network the
# database is `postgres:5432`; from the host it is the published port on localhost.

PP_ENV=local
PP_LOG_LEVEL=info

PP_MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:__POSTGRES_PASSWORD__@127.0.0.1:55432/promisepatch
PP_DATABASE_URL=postgresql+asyncpg://promisepatch_app:__APP_PASSWORD__@127.0.0.1:55432/promisepatch

PP_DB_APP_PASSWORD=__APP_PASSWORD__
PP_SESSION_SECRET=__SESSION_SECRET__
PP_DEMO_WORKER_PASSWORD=__WORKER_PASSWORD__
PP_DEMO_OWNER_PASSWORD=__OWNER_PASSWORD__
PP_ALLOW_FIXTURE_RESET=true

PP_CORS_ORIGINS=http://localhost:55173
PP_BAKERY_TZ=Africa/Tunis

# The order system, as reached from the host: the published port rather than the service name.
PP_ORDER_SYSTEM_BASE_URL=http://127.0.0.1:58100
PP_ORDER_SYSTEM_WEBHOOK_SECRET=__ORDER_WEBHOOK_SECRET__
