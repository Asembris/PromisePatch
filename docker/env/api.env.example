# The API container environment: the runtime connection, and nothing that could widen it.
#
# Generated by `uv run python scripts/bootstrap_local_env.py` into `api.env`, which is never
# committed.
#
# There is no administrative URL here and no `PP_DB_APP_PASSWORD`, on purpose. The API
# connects as `promisepatch_app`: a login that owns nothing, migrates nothing, cannot disable
# a trigger, cannot rewrite an append-only ledger and cannot truncate one. `PP_ALLOW_FIXTURE_RESET`
# is absent for the same reason -- a reset is an operator action, not a request the API serves.

PP_ENV=local
PP_LOG_LEVEL=info

# The least-privileged runtime role. `RuntimeDatabase.from_settings` refuses to start on any
# other login, so pointing this at the administrative credential is a startup failure rather
# than a quiet loss of least privilege.
PP_DATABASE_URL=postgresql+asyncpg://promisepatch_app:__APP_PASSWORD__@postgres:5432/promisepatch

# Signs the session cookie. Rotating it signs every outstanding session out.
PP_SESSION_SECRET=__SESSION_SECRET__

# The browser origin the frontend is served from. With the Vite proxy in front of the API the
# reads are same-origin and no CORS exchange happens at all; this is what the login endpoint
# checks the `Origin` header against. The port is the one compose publishes, not the one Vite
# listens on inside the network.
PP_CORS_ORIGINS=http://localhost:55173

PP_BAKERY_TZ=Africa/Tunis
