# The API container environment: the runtime connection, and nothing that could widen it.
#
# Generated by `uv run python scripts/bootstrap_local_env.py` into `api.env`, which is never
# committed.
#
# There is no administrative URL here and no `PP_DB_APP_PASSWORD`, on purpose. The API
# connects as `promisepatch_app`: a login that owns nothing, migrates nothing, cannot disable
# a trigger, cannot rewrite an append-only ledger and cannot truncate one. `PP_ALLOW_FIXTURE_RESET`
# is absent for the same reason -- a reset is an operator action, not a request the API serves.

PP_ENV=local
PP_LOG_LEVEL=info

# The least-privileged runtime role. `RuntimeDatabase.from_settings` refuses to start on any
# other login, so pointing this at the administrative credential is a startup failure rather
# than a quiet loss of least privilege.
PP_DATABASE_URL=postgresql+asyncpg://promisepatch_app:__APP_PASSWORD__@postgres:5432/promisepatch

# Signs the session cookie. Rotating it signs every outstanding session out.
PP_SESSION_SECRET=__SESSION_SECRET__

# The browser origins the frontend is served from. With the Vite proxy in front of the API the
# reads are same-origin and no CORS exchange happens at all; this is what the login endpoint
# checks the `Origin` header against. The port is the one compose publishes, not the one Vite
# listens on inside the network.
#
# Both spellings of that one published address, because compose publishes on `127.0.0.1:55173`
# and a browser sent there reports `http://127.0.0.1:55173` as its origin. To an exact-match
# allowlist `localhost` and `127.0.0.1` are different origins, so naming only one of them
# refuses a login from the very address the stack advertises. Two loopback literals and no
# wildcard: an origin that is neither of these is still refused.
PP_CORS_ORIGINS=http://localhost:55173,http://127.0.0.1:55173

# The external order system: the system of record for orders. PromisePatch keeps a mirror of
# it and pushes governed recovery amendments at it; it has no order editor of its own. The
# compose service name, not the published host port.
PP_ORDER_SYSTEM_BASE_URL=http://order-simulator:8100

# The shared secret an inbound order event is signed with. Service-to-service authentication:
# the sender is a server and holds no session. The same value the order system signs with.
PP_ORDER_SYSTEM_WEBHOOK_SECRET=__ORDER_WEBHOOK_SECRET__

# What a customer's approval link is signed with, and where it points. Both, or neither: a
# signed link with nowhere to point is not a link, and an address with no secret would produce
# one anybody could forge, so the customer surface stays closed unless the pair is set.
#
# The `worker` service reads this same file, which is what matters here: the link is composed
# in the transaction that creates the approval request, by the worker, with no HTTP request in
# scope. The base URL is the browser's origin -- the address the frontend is served from -- and
# not the API's own, because the link is opened by a person rather than called by a service.
PP_CUSTOMER_LINK_SECRET=__CUSTOMER_LINK_SECRET__
PP_CUSTOMER_LINK_BASE_URL=http://127.0.0.1:55173

PP_BAKERY_TZ=Africa/Tunis

# The conversational surface's entrance to the case engine: `/internal/intents`. Two values,
# and between them they are the whole identity story.
#
# The token authenticates the *MCP process*, not a person -- a server holds no session cookie,
# and a cookie it did hold would make every tool call a cross-site request. With it unset the
# intent endpoints answer 503 rather than serving an unauthenticated intent.
#
# The worker id is who every intent arriving through that surface is attested by, decided here
# rather than anywhere on the wire. No tool argument, no orchestrator and no model can name a
# different one, because there is no request field that carries an actor at all.
PP_INTERNAL_SERVICE_TOKEN=__INTERNAL_SERVICE_TOKEN__
PP_SURFACE_WORKER_ID=maya

# Whether this stack serves the scoped observer session at `POST /api/auth/demo-session`. On
# here because the local stack is the demo stack: somebody being shown the product reaches a
# real case in one action, with no credentials published anywhere for them to type. The session
# it issues names the seeded observer, which the domain admits to case reads and to no write at
# all -- so what this turns on is a way in, not an authority. Off by default everywhere else.
PP_DEMO_SESSION_ENABLED=true

# Which provider answers a semantic job. `fake` is deterministic, reaches no network and needs
# no credential: the local stack comes up on a machine that has never authenticated to AWS,
# and nothing here mounts an AWS profile into a container.
PP_LLM_PROVIDER=fake

# ---------------------------------------------------------------------------------------------
# A SUR-1 scored run needs a different stack from this one, and the harness refuses it otherwise.
#
# Two of the values above are wrong for a comparative benchmark, and both were wrong for all
# three scored runs that have been taken:
#
#   PP_LLM_PROVIDER=fake           arms B and C answer every semantic job with the deterministic
#                                  fake while the baseline arm calls Nova, so any difference the
#                                  run measures could be the model rather than the architecture.
#   PP_DEMO_SESSION_ENABLED=true   `provisioning.ensure_demo_case` runs at every worker start,
#                                  and the harness restarts the worker around every world
#                                  install -- so a demo case is opened inside the scenario's own
#                                  world, and attests a physical fact, before any arm acts.
#
# For a scored stack, and only for one:
#
#   PP_LLM_PROVIDER=bedrock
#   PP_BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0
#   PP_AWS_REGION=us-east-1
#   PP_DEMO_SESSION_ENABLED=false
#
# plus a path by which the AWS credential chain resolves *inside the worker container*. Recreate
# `api` and `worker` afterwards; an env file edited under a running container changes nothing.
#
# Confirm it from the process that will do the work, never from this file:
#
#   docker compose exec -T worker pp runtime-identity
#
# The scored preflight asks the same process the same question, and refuses the run on either
# value being wrong. See `docs/sur1-parity-correction.md`.
# ---------------------------------------------------------------------------------------------

