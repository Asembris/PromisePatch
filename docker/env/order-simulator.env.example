# The External Order System simulator's environment.
#
# Generated by `uv run python scripts/bootstrap_local_env.py` into `order-simulator.env`, which
# is never committed.
#
# This is a different system, so it has a prefix of its own and holds none of PromisePatch's
# credentials. There is no database URL here and no session secret: the only thing it knows
# about PromisePatch is where to post an order event and the secret it signs one with.

OS_LOG_LEVEL=info

# Its own store, on its own volume. Never inside the PromisePatch database volume: two systems
# sharing storage is exactly what this application exists to demonstrate is not happening.
OS_DATABASE_PATH=/data/order-simulator.sqlite3

# Where a committed order event is delivered. The compose service name, not the published host
# port -- inside the network PromisePatch answers on its own port.
OS_WEBHOOK_URL=http://api:8000/api/integrations/order-system/events

# The shared secret every outbound event is signed with. The same value PromisePatch reads as
# PP_ORDER_SYSTEM_WEBHOOK_SECRET; the two sides cannot talk if they disagree.
OS_WEBHOOK_SECRET=__ORDER_WEBHOOK_SECRET__
