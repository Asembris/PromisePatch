# The MCP container environment: a credential in, a credential out, and no database at all.
#
# Generated by `uv run python scripts/bootstrap_local_env.py` into `mcp.env`, which is never
# committed.
#
# There is no `PP_DATABASE_URL` here and there must not be. The MCP process reaches a case the
# way any other client would -- an authenticated HTTP call to the intent API -- and an
# import-linter contract stops the code from doing anything else. Handing it a connection
# string would make that boundary a convention again.

PP_ENV=local
PP_LOG_LEVEL=info

# What an MCP client must present to `/mcp`. The local and self-hosted inbound credential; a
# deployment on AgentCore Runtime replaces it with SigV4 at the edge, which changes the
# credential and nothing about who the server says is speaking. With it unset the process
# refuses to start rather than accepting a tool call from whoever found the port.
PP_MCP_BEARER_TOKEN=__MCP_BEARER_TOKEN__

# What this process presents to the intent API. The same shared secret the API is configured
# with, held by exactly those two.
PP_INTERNAL_SERVICE_TOKEN=__INTERNAL_SERVICE_TOKEN__

# Where the case engine answers. The compose service name, not the published host port.
PP_MCP_INTENT_API_BASE_URL=http://api:8000

# DNS-rebinding protection, as the transport spec requires. Origins are empty by default and
# deliberately not inherited from `PP_CORS_ORIGINS`: the evidence UI and the tool endpoint are
# different surfaces with different callers. A non-browser client sends no `Origin` at all and
# is unaffected; it is authenticated by its bearer token like any other.
PP_MCP_ALLOWED_ORIGINS=
PP_MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,mcp:*
