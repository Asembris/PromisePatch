# Planning documents — local only, never tracked
ARCHITECTURE_PLAN.md
PROMISEPATCH_PRODUCT_SPEC.md

# Python environments
.venv/
venv/
.env
.env.*
!.env.example

# Python build / cache
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
coverage.xml
htmlcov/

# Node / frontend
node_modules/
dist/
build/
.vite/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local data / infra artifacts
*.sqlite3
*.db
cdk.out/
.mcp.json

# Generated local-stack environment. The committed *.env.example templates are the shape;
# the rendered files hold generated credentials and never leave the machine.
docker/env/*.env

# An optional local root CA for container builds; machine-specific, never shared.
docker/env/extra-ca.crt

# Evaluation run output: summaries and the local cost ledger are facts about one machine at
# one moment. A deliberately chosen summary may be committed later as evidence; a run is not
# committed just because it happened.
.eval-results/

# DeepEval's own local caches and its temporary test-run files.
.deepeval*
temp_test_run_data.json

# Playwright output: reports, traces, videos and screenshots are run artefacts.
test-results/
playwright-report/
blob-report/
.playwright/
playwright/.cache/
