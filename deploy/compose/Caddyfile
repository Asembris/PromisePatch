# The TLS boundary. Uploaded to SSM as /promisepatch/<env>/caddyfile and written to
# /opt/promisepatch/Caddyfile at every boot.
#
# Caddy holds the certificate and nothing else: it terminates TLS and forwards. It makes no
# authorization decision, adds no header the backend trusts and strips nothing the backend
# needs. The MCP server's own bearer check, Origin allowlist and Host validation stay exactly
# where P5.1 put them -- in front of the protocol, inside the mcp process -- because a proxy
# that authenticated on their behalf would move the authority boundary out of the code that
# the import-linter contract constrains.

# An approval link is a possession credential (ADR-0021), in `?approve=` or the approval path.
# No log line keeps it: the access log, the error log (the default logger) and any Referer or
# redirect Location that could carry it. docs/phase7-approval-log-privacy-repair.md
(redact) {
	format filter {
		wrap json
		request>uri regexp "(approve=|approval/)[^?&#]+|v1\.[\w-]{20,}\.[\w-]{20,}" "${1}REDACTED"
		request>headers>Referer delete
		resp_headers>Location delete
	}
}

{
	# A reachable contact, from /promisepatch/<env>/acme-contact, so a certificate problem arrives
	# as mail. Empty rather than made up: ACME validates it, and a dead domain fails the order.
	email "{$ACME_CONTACT:}"
	log default {
		import redact
	}
}

{$TLS_HOSTNAME} {
	# Automatic HTTPS. A publicly trusted certificate for this exact name, renewed in the
	# background, verified by every client. No self-signed certificate is issued anywhere in
	# this deployment and no client is asked to skip verification.

	encode zstd gzip

	# The MCP Streamable HTTP endpoint. `flush_interval -1` disables response buffering, which
	# a streamed protocol needs: buffering would hold a server-sent event until the response
	# completed and turn a stream into a single late block.
	handle /mcp* {
		reverse_proxy mcp:8001 {
			flush_interval -1
			transport http {
				read_timeout 300s
				write_timeout 300s
			}
		}
	}

	# The API: the session-authenticated workspace reads, and the signed webhook the separate
	# order system posts to. Both reach the same process on the same port they do locally.
	handle /api* {
		reverse_proxy api:8000
	}

	handle /events* {
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}

	handle /readyz {
		reverse_proxy api:8000
	}

	handle /healthz {
		reverse_proxy api:8000
	}

	# The intent API is reachable from the `mcp` container and from nowhere else. The catch-all
	# below ends the old allowlist, so the refusal is stated rather than inherited, and
	# `scripts/deployment_smoke.py` asserts it from outside.
	handle /internal* {
		respond 404
	}

	# Everything else is the evidence UI, served by the API process out of the backend
	# image (ADR-0012). Last, so every handle above still wins, and an unknown `/api/...`
	# path is answered by the API's own JSON 404 rather than by a page.
	handle {
		reverse_proxy api:8000
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin"
		-Server
	}

	log {
		output stdout
		import redact
	}
}

# A name this deployment does not serve. Without this block Caddy answers an empty 200, which a
# client cannot tell from success. It moves no authority: the MCP server's own Host, Origin and
# bearer checks stay where P5.1 put them. The named site above is more specific and still wins.
:443 {
	respond "this deployment does not serve that name" 421
}
