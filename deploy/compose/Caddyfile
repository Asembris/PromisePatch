# The TLS boundary. Uploaded to SSM as /promisepatch/<env>/caddyfile and written to
# /opt/promisepatch/Caddyfile at every boot.
#
# Caddy holds the certificate and nothing else: it terminates TLS and forwards. It makes no
# authorization decision, adds no header the backend trusts and strips nothing the backend
# needs. The MCP server's own bearer check, Origin allowlist and Host validation stay exactly
# where P5.1 put them -- in front of the protocol, inside the mcp process -- because a proxy
# that authenticated on their behalf would move the authority boundary out of the code that
# the import-linter contract constrains.

{
	# An explicit, reachable contact so a certificate problem arrives as mail rather than as an
	# outage: set /promisepatch/<env>/acme-contact and the host passes it through. The default
	# is empty rather than a made-up address, because ACME registration validates the contact
	# and an unresolvable domain fails the certificate order outright -- no contact is allowed,
	# a contact nobody can receive mail at is not.
	email "{$ACME_CONTACT:}"
}

{$TLS_HOSTNAME} {
	# Automatic HTTPS. A publicly trusted certificate for this exact name, renewed in the
	# background, verified by every client. No self-signed certificate is issued anywhere in
	# this deployment and no client is asked to skip verification.

	encode zstd gzip

	# The MCP Streamable HTTP endpoint. `flush_interval -1` disables response buffering, which
	# a streamed protocol needs: buffering would hold a server-sent event until the response
	# completed and turn a stream into a single late block.
	handle /mcp* {
		reverse_proxy mcp:8001 {
			flush_interval -1
			transport http {
				read_timeout 300s
				write_timeout 300s
			}
		}
	}

	# The API: the session-authenticated workspace reads, and the signed webhook the separate
	# order system posts to. Both reach the same process on the same port they do locally.
	handle /api* {
		reverse_proxy api:8000
	}

	handle /events* {
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}

	handle /readyz {
		reverse_proxy api:8000
	}

	handle /healthz {
		reverse_proxy api:8000
	}

	# Nothing else is served. The evidence UI is not deployed by this stack yet, so an
	# unmatched path is a 404 from here rather than a route into something unfinished.
	handle {
		respond "PromisePatch deployed loop. Endpoints: /mcp, /api, /readyz" 404
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}

	log {
		output stdout
		format json
	}
}

# Anything addressed to a name this deployment does not serve. Without this block Caddy has no
# site for such a request and answers its "no site matched" default -- an empty 200, which a
# client cannot tell from success. The request is refused either way and never reaches the
# protocol; what this fixes is the deployment saying so. It does not move the authority
# boundary: the MCP server's own Host allowlist, Origin allowlist and bearer check stay exactly
# where P5.1 put them, in front of the protocol, for every request Caddy does pass through.
# The named site above is more specific, so it continues to win for the real hostname.
:443 {
	respond "this deployment does not serve that name" 421
}
