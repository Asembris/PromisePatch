# PromisePatch frontend — local configuration.
#
# Copy to `apps/frontend/.env.local` if you need to change a default. Nothing here is a
# secret: every value in a Vite `VITE_`-prefixed variable is compiled into the bundle and is
# readable by anyone who loads the page. Database URLs, the session secret, worker passwords
# and service tokens belong in the backend's own `.env` and never in this file.

# Origin the API is served from. Empty is the default and the recommended local setting: the
# app then calls `/api` and `/events` on its own origin, the Vite dev server proxies both to
# the backend, and the session cookie is same-origin with no CORS involved.
# Set this only when the frontend is served from a different origin than the API, in which
# case that origin must also appear in the backend's PP_CORS_ORIGINS.
VITE_API_BASE_URL=

# Where the Vite dev server forwards /api and /events. Build-time only; ignored in production.
VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:8000
