# PromisePatch — local configuration.
#
# Copy this file to `.env` and adjust. `.env` is never committed.
# The `PP_`-prefixed variables are exactly the settings the application reads; a test asserts
# the two match in both directions, so they cannot drift ahead of or behind the
# implementation. Anything without that prefix is read by the local stack rather than by
# PromisePatch itself, and is listed at the end.
# No secrets and no AWS credentials belong in either file.

# Where this process is running: local | aws. `aws` closes the interactive docs.
PP_ENV=local

# Root log level: debug | info | warning | error.
PP_LOG_LEVEL=info

# Comma-separated browser origins allowed to call the API with credentials.
PP_CORS_ORIGINS=http://localhost:5173

# The connection the API serves every request over: the least-privileged runtime role.
# Placeholder only -- put the real URI in .env, never here.
# Same host and database as PP_MIGRATION_DATABASE_URL, a different login. Behind a connection
# pooler the username carries the project reference: promisepatch_app.PROJECTREF
PP_DATABASE_URL=postgresql+asyncpg://promisepatch_app:PASSWORD@HOST:5432/postgres

# Admin/DDL connection used by Alembic and by the schema integration tests.
# Placeholder only -- put the real URI in .env, never here.
# Supabase: use the Session Pooler URI and swap the scheme to postgresql+asyncpg.
PP_MIGRATION_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/postgres

# Password for the least-privileged runtime role `promisepatch_app`, read only by the
# migration that creates and rotates that role. Placeholder only -- put the real value in
# .env, never here. Requests never use it: they use PP_DATABASE_URL above.
PP_DB_APP_PASSWORD=

# Key the session cookie is signed with. Placeholder only -- put a real random value in
# .env, never here. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it signs every outstanding session out.
PP_SESSION_SECRET=

# Seeded demo logins written by `pp reset-demo-state`, hashed with Argon2 before storage.
# Placeholders only -- put the real values in .env, never here.
PP_DEMO_WORKER_PASSWORD=
PP_DEMO_OWNER_PASSWORD=

# The commit the container image was built from. Set by the image build, never by hand and
# never in a .env file: it is what `/healthz` reports so that which build is answering is a
# question a caller can answer. Empty outside an image, which is every local run.
PP_IMAGE_TAG=

# Where the built browser bundle is, for the deployment whose backend image carries it
# (ADR-0012). Empty here and everywhere else: local development serves the page from the Vite
# dev server, and only the deployed image sets this, to the directory it copied the bundle
# into. A directory with no index.html in it refuses to start rather than serving a blank page.
PP_STATIC_ROOT=

# Whether this deployment serves the scoped observer session endpoint,
# `POST /api/auth/demo-session`. It takes no credentials and publishes none: the server chooses
# the principal (the seeded observer), the expiry and the CSRF token, and the domain admits that
# principal to case reads and to no write. Off unless a deployment deliberately wants a
# one-action way in for somebody being shown the product.
PP_DEMO_SESSION_ENABLED=false

# Whether this deployment permits `pp reset-demo-state` at all. A reset deletes every domain
# row PromisePatch owns, so it is off unless someone who knows which database this is says so.
# It authorises the operation, not the target: the backend test suite additionally refuses to
# run against any database that is not this machine's disposable one, so turning this on
# cannot aim the suite at a hosted database.
PP_ALLOW_FIXTURE_RESET=false

# The external order system PromisePatch pushes governed recovery amendments at. It is the
# system of record for orders; PromisePatch keeps a mirror of it and has no order editor.
# Unset means no order system is configured and amendments go to the fake provider instead.
PP_ORDER_SYSTEM_BASE_URL=

# The shared secret an inbound order event is signed with (HMAC-SHA256 over timestamp + body).
# Service-to-service authentication, never a browser session. Placeholder only -- put the real
# value in .env, never here, and use the same value on the order system's side.
PP_ORDER_SYSTEM_WEBHOOK_SECRET=

# How long one amendment call may take before it counts as an uncertain delivery. Uncertain,
# not failed: the retry presents the same idempotency key and the order system decides.
PP_ORDER_SYSTEM_TIMEOUT_SECONDS=10.0

# The secret a customer's approval link is signed with (HMAC-SHA256 over the request id and the
# channel it was sent to). What a link proves is possession -- that whoever opened it was given
# it -- never identity: there is no account behind a bakery customer and nobody to check. Unset
# closes the customer surface entirely, which is the safe direction; a link nobody signed is a
# link anybody could write. Placeholder only -- put the real value in .env, never here.
PP_CUSTOMER_LINK_SECRET=

# Where a customer's approval link points: the public address of the evidence surface. Composed
# by the worker in the transaction that creates the request, so it cannot be derived from a
# request. Deliberately not defaulted -- a default would put a localhost address in a message
# sent to a real customer. Both this and the secret must be set before any link is minted.
PP_CUSTOMER_LINK_BASE_URL=

# Which transport carries a message to a customer: fake | telegram. The fake delivers to an
# in-memory provider, reaches no network and needs no credential, which is why it is the default
# for local work and CI -- and why a machine that has never talked to Telegram can run the whole
# consent protocol end to end. Selecting `telegram` is a deliberate act: the other end of the
# channel is a real person's phone, and a process selected for it with no token refuses to start.
PP_CUSTOMER_CHANNEL_PROVIDER=fake

# The Telegram Bot API credential outbound customer messages are sent with, from BotFather.
# Required only when PP_CUSTOMER_CHANNEL_PROVIDER=telegram. It is the whole of the bot's
# authority -- anyone holding it can send as this bakery -- so it is a placeholder here and
# belongs only in .env, never in this file and never in a commit.
#
# It is outbound only. There is no webhook, no `getUpdates` and no inbound path: a customer
# answers through the signed link the message carries, on the surface that already exists.
PP_TELEGRAM_BOT_TOKEN=

# How long one sendMessage call may take before it counts as an uncertain delivery. Uncertain,
# not failed: the Bot API has no idempotency key, so a retry after a timeout may put a second
# copy of one message on a customer's phone. It is the same proposal with the same link either
# way -- never a second question, and never a second authority.
PP_TELEGRAM_TIMEOUT_SECONDS=10.0

# Which provider answers a semantic job: fake | bedrock. The fake is deterministic, reaches
# no network and needs no credential, which is why it is the default for local work and CI.
PP_LLM_PROVIDER=fake

# The Region whose Bedrock endpoint is called. Not a credential: which identity the call is
# made as comes from the AWS SDK's own chain (a profile, an SSO session, a task role) at call
# time. No AWS access key belongs in this file or in .env.
PP_AWS_REGION=us-east-1

# The one model, as ADR-0007 selects it: Nova 2 Lite through a cross-Region inference profile.
# One model for every job -- no router and no automatic escalation. ADR-0004 named Claude
# Haiku 4.5; it is still a supported value here, but it is not what this account can call.
PP_BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0

# How long one semantic call may take before it is abandoned. A ceiling, not a target: these
# calls sit inside a spoken turn.
PP_BEDROCK_TIMEOUT_SECONDS=10.0

# How many times the AWS SDK may retry one throttled or failed call, counting the first.
# Transport only -- a malformed answer gets exactly one corrective retry and is then refused.
PP_BEDROCK_MAX_ATTEMPTS=3

# Whether a model is asked to phrase a user-facing explanation. Off: the P4.8 explanation gate
# selected PromisePatch's own deterministic renderer. The bounded verbalisation path was safe --
# no outcome or authority contradiction, no invented quantity -- but did not reliably say a fact
# it was required to say, so completeness is a property of the renderer rather than of a sample.
# The verbalisation path is kept and is one variable away; turning it on is how a later phase
# measures a different model, not a fallback anything reaches on its own.
PP_EXPLANATION_VERBALISATION=false

# ------------------------------------------- the conversational surface (MCP + intent API)
#
# Two hops, two credentials, and one thing neither of them carries. An MCP client authenticates
# to the `mcp` process; the `mcp` process authenticates to the API's `/internal/intents`. *Who
# is speaking* is configured on the server at the far end of both and is never read off the
# wire -- there is no request field anywhere in the chain that carries an actor.

# The staff member every intent arriving through the conversational surface is attested by. The
# intent endpoints answer 503 with this unset: an intake with no attestor is a physical claim
# nobody made. `maya` is the demo fixture's baker.
PP_SURFACE_WORKER_ID=

# The shared secret the `/internal/intents` endpoints require of their caller. Service to
# service, not a session: the caller is the `mcp` process and holds no cookie. Unset means the
# endpoints refuse every call rather than serving unauthenticated ones.
PP_INTERNAL_SERVICE_TOKEN=

# What an MCP client must present to the Streamable HTTP endpoint. The local and self-hosted
# inbound credential; a deployment behind AgentCore Runtime replaces it with SigV4 at the edge.
# The `mcp` process refuses to start with this unset, because a server with no inbound
# credential accepts a tool call from whoever found the port.
PP_MCP_BEARER_TOKEN=

# Where the case engine answers, for the `mcp` process. Deliberately not defaulted: a default
# would mean a process nobody configured would try to open cases on whatever answered there.
PP_MCP_INTENT_API_BASE_URL=

# How long one intent call may take before the tool reports the engine unreachable. A timeout
# is an unavailable reading, never a reading.
PP_MCP_INTENT_TIMEOUT_SECONDS=10.0

# DNS-rebinding protection, as the transport spec requires. Origins are empty by default and
# deliberately not inherited from PP_CORS_ORIGINS: the evidence UI and the tool endpoint are
# different surfaces with different callers. A non-browser client sends no Origin at all and is
# unaffected. `:*` in the host list matches any port.
PP_MCP_ALLOWED_ORIGINS=
PP_MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*

# Answer a tool call as one JSON body instead of an SSE stream. Off, so the server exercises
# the same event-stream framing a real Streamable HTTP client meets; the JSON-RPC messages are
# identical either way.
PP_MCP_JSON_RESPONSE=false

# Where the conversational orchestrator (`pp converse`) connects, as an ordinary MCP client.
# The MCP endpoint's own address; it authenticates with PP_MCP_BEARER_TOKEN above.
PP_ORCHESTRATOR_MCP_URL=
# How long one tool call from the orchestrator may take before it is reported unreachable.
PP_ORCHESTRATOR_TIMEOUT_SECONDS=30.0

# The bakery's local timezone. Used to read a wall-clock `--anchor` for a demo reset; every
# stored timestamp stays UTC.
PP_BAKERY_TZ=Africa/Tunis

# --------------------------------------------------------------- evaluation only

# The credential the customer-intent challenger uses to reach OpenAI. Read by
# `scripts/run_intent_challenger.py` and by nothing else: it carries no `PP_` prefix because
# the application never sees it, there is no runtime route to OpenAI, and no deployed process
# needs it. A plan runs without it; a live challenger stage refuses before constructing a
# client when it is absent.
#
# It is not an authorisation. Buying inference additionally takes a scope-bound phrase typed at
# the invocation, which is never read from this file or from the environment. A key present and
# no phrase typed buys nothing.
OPENAI_API_KEY=

# The credential the same challenger uses to reach NVIDIA's hosted NIM endpoint, on exactly the
# same terms: read by `scripts/run_intent_challenger.py` and by nothing else, no `PP_` prefix
# because no deployed process needs it, no runtime route to NVIDIA, and not an authorisation.
# A key present and no scope-bound phrase typed at the invocation buys nothing.
NVIDIA_API_KEY=

# Which NVIDIA endpoint that challenger is defined against. Not a secret -- it is an address,
# and a preflight prints it, because which host answered is half of what a result means.
#
# Leaving it unset is fine: the value below is the documented default and is the only endpoint
# the run would be allowed to use anyway. What is refused is a value that is *not* this one --
# a local NIM container, an Ollama server, a proxy or a partner deployment could all answer to
# the same model name, and each would be a different measurement recorded under one label. So
# a configured foreign endpoint stops the run before a client exists rather than being used.
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1

# --------------------------------------------------------------- the local Docker stack
# Read by `docker compose` and by `scripts/`, never by the application, which is why it does
# not carry the `PP_` prefix.

# Which port on this machine the compose stack publishes PostgreSQL on. The container's own
# port is always 5432 and does not move; this is only the host side of the mapping. Change it
# when 55432 cannot be bound -- on Windows, `netsh interface ipv4 show excludedportrange
# protocol=tcp` lists the ranges Hyper-V and WinNAT have reserved, and a reservation covering
# 55432 makes `docker compose up` fail to publish. `scripts/bootstrap_local_env.py` writes the
# same value into `docker/env/host.env`, and `scripts/with_local_env.py` honours it for a
# `host.env` that already exists, so compose and the test suite cannot disagree.
PROMISEPATCH_POSTGRES_PUBLISHED_PORT=55432
