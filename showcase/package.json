{
  "name": "promisepatch-showcase",
  "version": "0.0.0",
  "private": true,
  "description": "Static GitHub Pages showcase for PromisePatch. A presentation artefact; no product behaviour.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "verify:assets": "node tools/verify-assets.mjs",
    "verify:content": "node tools/verify-content.mjs",
    "verify:links": "node tools/verify-links.mjs",
    "check:budgets": "node tools/check-budgets.mjs",
    "verify": "npm run verify:assets && npm run verify:content && npm run verify:links && npm run check:budgets",
    "test": "playwright test",
    "check": "npm run build && npm run verify && npm run test",
    "render:touch-icon": "node tools/render-touch-icon.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/instrument-sans": "5.3.0",
    "@playwright/test": "1.63.0",
    "vite": "8.3.1"
  },
  "dependencies": {
    "three": "0.149.0"
  }
}
